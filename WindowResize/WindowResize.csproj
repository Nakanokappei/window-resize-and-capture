<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WindowResizeCapture</AssemblyName>
    <RootNamespace>WindowResizeCapture</RootNamespace>
    <!-- Without these the binary reports version 1.0.0.0 and the assembly name
         as its description, which is what Windows shows in the file properties,
         Task Manager and the installed-programs list. Keep the version in step
         with SplashForm.cs, Package/AppxManifest.xml and installer/WindowResize.iss. -->
    <Version>1.8.2</Version>
    <AssemblyTitle>Window Resize &amp; Capture</AssemblyTitle>
    <Product>Window Resize &amp; Capture</Product>
    <Company>Kappei Nakano</Company>
    <Copyright>Copyright © 2026 Kappei Nakano</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- Suppress platform compatibility warnings for WinRT APIs guarded by IsPackaged() -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Compress the single-file bundle to reduce download size.
         PublishTrimmed is NOT used: WinForms relies heavily on COM interop
         and UI Automation types that the IL trimmer cannot safely analyze,
         causing TypeLoadException at runtime (UiaCore, ComponentManager). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- The studio that photographs this app for its store listing is a tool for
       whoever maintains it, and nothing a person who installs the app can reach.
       So it is not built into what ships: no code for it, no strings for it, and
       nothing in the binary to read. Debug keeps it, which is where the pictures
       are taken from. Program.cs and TrayApplicationContext.cs guard their two
       calls into it with #if DEBUG for the same reason. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Studio\**" />
  </ItemGroup>

  <!-- UseWindowsForms requires Windows Desktop SDK which isn't on macOS.
       Instead, reference the framework directly via FrameworkReference. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" />
    <EmbeddedResource Include="Resources\splash.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- MSIX packaging assets (not embedded, included in package layout) -->
  <ItemGroup>
    <None Include="Package\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
